# Newsletter Integration (Mailchimp)
# Get these values from your Mailchimp account:
# 1. API Key: Account > Extras > API Keys
# 2. List ID: Audience > Settings > Audience name and defaults
# 3. Server Prefix: The part after the dash in your API key (e.g., us15)

MAILCHIMP_API_KEY=your_mailchimp_api_key_here
MAILCHIMP_LIST_ID=your_mailchimp_list_id_here
MAILCHIMP_SERVER_PREFIX=us15

# Stripe Configuration (add these to your environment)
# Get these keys from your Stripe Dashboard: https://dashboard.stripe.com/apikeys

# Publishable key (safe to expose in client-side code)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Secret key (keep this secure, server-side only)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Webhook secret (for handling Stripe events)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Preview Mode (for blog drafts)
PREVIEW_SECRET=your_preview_secret_here

# Development
NODE_ENV=development
DEBUG_MODE=true
DEBUG_LEVEL=debug
# Tools
NEXT_PUBLIC_DEBUG_DASHBOARD=true
NEXT_PUBLIC_ENABLE_CONSOLE_LOGS=true

# CI/CD & Deployment Configuration
# Azure Resource Group for container deployments
AZURE_RG=artistsite-resources

# Staging Environment Variables
STAGING_STRIPE_PUBLISHABLE_KEY=pk_test_staging_key_here
STAGING_STRIPE_SECRET_KEY=sk_test_staging_key_here
STAGING_MAILCHIMP_API_KEY=staging_mailchimp_api_key_here
STAGING_MAILCHIMP_LIST_ID=staging_mailchimp_list_id_here

# Production Environment Variables
PROD_STRIPE_PUBLISHABLE_KEY=pk_live_production_key_here
PROD_STRIPE_SECRET_KEY=sk_live_production_key_here
PROD_MAILCHIMP_API_KEY=production_mailchimp_api_key_here
PROD_MAILCHIMP_LIST_ID=production_mailchimp_list_id_here

# Monitoring & Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
LHCI_GITHUB_APP_TOKEN=your_lighthouse_ci_token_here

# GitHub Container Registry
# These are automatically provided by GitHub Actions
# GITHUB_TOKEN=automatically_provided_by_actions

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/artistsite"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-make-it-long-and-random"

# Google OAuth (optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Stripe (for payments)
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"