{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "next.config.ts",
    "src/app/**/*.{ts,tsx}",
    "src/ui/**/*.{ts,tsx}",
    "src/domain/**/*.{ts,tsx}",
    "src/server/**/*.{ts,tsx}",
    "src/components/**/*.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx,js,jsx}"
  ],
  "ignoreDependencies": [
    "@testing-library/jest-dom",
    "@auth/prisma-adapter",
    "@heroicons/react",
