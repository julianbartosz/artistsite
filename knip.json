    "@prisma/client",
    "@tailwindcss/typography",
    "@tiptap/extension-character-count",
    "@tiptap/extension-image",
    "@tiptap/extension-link",
    "@tiptap/extension-placeholder",
    "@tiptap/react",
    "@tiptap/starter-kit",
    "@types/bcryptjs",
    "clsx",
    "critters",
    "date-fns",
    "lucide-react",
    "mdx-bundler",
    "next-sitemap",
    "prisma",
    "react-hook-form",
    "schema-dts",
    "stripe",
    "swr",
