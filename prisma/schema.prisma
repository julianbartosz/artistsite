// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  accounts      Account[]
  sessions      Session[]
  
  // Customer-specific fields
  orders        Order[]
  addresses     Address[]
  wishlist      WishlistItem[]
  viewHistory   ProductView[]
  searchQueries SearchQuery[]
  updateAudience BlogPostAudience[]
  studioThreads  StudioMessageThread[]
  savedUpdates   SavedUpdate[]
  updateComments UpdateComment[]
  updateLikes    UpdateLike[]
  
  // Profile information
  firstName     String?
  lastName      String?
  dateOfBirth   DateTime?
  preferences   Json? // Store customer preferences as JSON
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id          String  @id @default(cuid())
  userId      String
  type        String  // 'shipping', 'billing'
  isDefault   Boolean @default(false)
  
  firstName   String
  lastName    String
  company     String?
  address1    String
  address2    String?
  city        String
  state       String
  postalCode  String
  country     String
  phone       String?
  
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  userId          String?
  userEmail       String
  
  // Order details
  status          String   // OrderStatus enum values
  type            String   // OrderType enum values
  
  // Pricing
  subtotal        Float
  shipping        Float
  tax             Float
  total           Float
  currency        String   @default("USD")
  
  // Payment
  paymentIntentId String?
  paymentStatus   String
  paymentMethod   String?
  stripeSessionId String?  @unique
  
  // Shipping
  shippingAddressId String?
  billingAddressId  String?
  shippingAddress   Address? @relation(fields: [shippingAddressId], references: [id])
  shippingCarrier    String?
  trackingNumber    String?
  shipmentId        String?
  shippingLabelUrl  String?
  estimatedDelivery DateTime?
  
  // Special instructions
  specialInstructions String?
  giftMessage        String?
  marketEventId      String?
  
  // Relations
  user        User?        @relation(fields: [userId], references: [id])
  marketEvent MarketEvent? @relation(fields: [marketEventId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  timeline    OrderTimelineEntry[]
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([marketEventId])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int
  unitPrice       Float
  totalPrice      Float
  
  // Product details (snapshot at time of order)
  productTitle    String
  productImage    String
  
  // Variants and customizations (stored as JSON)
  selectedVariant Json?
  customizations  Json?
  notes          String?
  
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

model OrderTimelineEntry {
  id            String   @id @default(cuid())
  orderId       String
  status        String
  message       String
  details       String?
  trackingNumber String?
  timestamp     DateTime @default(now())
  
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  
  // Product details (for quick access)
  productTitle String
  productImage String
  productPrice Float
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([userId, productId])
}

// New models for Phase 4: Product Recommendations & Search

model ProductView {
  id        String   @id @default(cuid())
  userId    String?  // Optional for guest users
  productId String
  sessionId String?  // For guest tracking
  
  // Analytics data
  source    String?  // 'search', 'recommendation', 'category', 'direct'
  referrer  String?
  duration  Int?     // Time spent viewing in seconds
  
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

model ProductAnalytics {
  id           String   @id @default(cuid())
  productId    String   @unique
  
  // View metrics
  totalViews   Int      @default(0)
  uniqueViews  Int      @default(0)
  avgViewTime  Float    @default(0)
  
  // Engagement metrics
  wishlistAdds Int      @default(0)
  cartAdds     Int      @default(0)
  purchases    Int      @default(0)
  
  // Performance metrics
  conversionRate Float  @default(0) // cart adds / views
  popularityScore Float @default(0) // Calculated score for recommendations
  
  // Timestamps
  lastCalculated DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SearchQuery {
  id        String   @id @default(cuid())
  query     String
  userId    String?
  sessionId String?
  
  // Results
  resultCount Int
  clickedResults Json? // Array of product IDs that were clicked
  
  // Analytics
  source    String?  // 'autocomplete', 'manual', 'filter'
  filters   Json?    // Applied filters
  sortBy    String?  // Sort option used
  
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  createdAt DateTime @default(now())
}

model ProductRecommendation {
  id                String   @id @default(cuid())
  sourceProductId   String   // Product that triggered recommendation
  recommendedProductId String // Product being recommended
  
  // Recommendation type and scoring
  type          String   // 'similar', 'frequently_bought_together', 'viewed_together'
  score         Float    // Recommendation strength (0-1)
  clickCount    Int      @default(0)
  conversionCount Int    @default(0)
  
  // Metadata
  reason        String?  // Human-readable reason for recommendation
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([sourceProductId, recommendedProductId, type])
}

model Product {
  id              String   @id
  slug            String   @unique
  title           String
  description     String
  price           Float
  currency        String   @default("USD")
  category        String
  medium          String
  dimensions      String
  year            Int
  availability    String   @default("available")
  featured        Boolean  @default(false)
  images          Json
  tags            Json
  shipping        Json
  specifications  Json
  variants        Json?
  customizations  Json?
  relatedProducts Json?
  bundle          Json?
  commissionInfo  Json?
  edition         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([availability])
  @@index([category])
  @@index([featured])
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @default("")
  content     String
  publishedAt DateTime @default(now())
  tags        Json
  isDraft     Boolean  @default(true)
  featured    Boolean  @default(false)
  coverImage  String?
  author      String   @default("Artist")
  format      String   @default("article") // article | short
  visibility  String   @default("public") // public | private
  media       Json     @default("[]")
  relatedProductId  String?
  relatedArtworkSlug String?
  relatedOrderId    String?  @unique
  pullQuote   String?
  location    String?
  processStage String?
  audience    BlogPostAudience[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isDraft, publishedAt])
  @@index([visibility, isDraft, publishedAt])
  @@index([format])
  @@index([featured, publishedAt])
  @@index([relatedOrderId])
}

model StudioMessageThread {
  id               String   @id @default(cuid())
  subject          String
  userId           String?
  userEmail        String
  userName         String?
  relatedPostSlug  String?
  relatedOrderId   String?
  status           String   @default("open")
  crmStage         String   @default("new")
  tags             Json     @default("[]")
  artistLastReadAt DateTime?
  userLastReadAt   DateTime?
  lastMessageAt    DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages StudioMessage[]

  @@index([userEmail])
  @@index([userId])
  @@index([lastMessageAt])
  @@index([relatedPostSlug])
  @@index([crmStage])
}

model UpdateComment {
  id        String   @id @default(cuid())
  postSlug  String
  userId    String
  body      String
  status    String   @default("visible")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postSlug, status, createdAt])
}

model UpdateLike {
  id        String   @id @default(cuid())
  postSlug  String
  userId    String?
  sessionId String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postSlug])
}

model StudioMessage {
  id           String   @id @default(cuid())
  threadId     String
  senderRole   String
  senderUserId String?
  body         String
  createdAt    DateTime @default(now())

  thread StudioMessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model SavedUpdate {
  id        String   @id @default(cuid())
  userId    String
  postSlug  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postSlug])
  @@index([userId])
}

model BlogPostAudience {
  id     String @id @default(cuid())
  postId String
  userId String?
  email  String

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([postId, email])
  @@index([email])
  @@index([userId])
}

model SiteSetting {
  key       String   @id
  value     String
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Artwork {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  medium      String   @default("Mixed Media")
  dimensions  String   @default("")
  year        String
  category    Json
  featured    Boolean  @default(false)
  available   Boolean  @default(false)
  price       String?
  images      Json
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([available])
  @@index([featured])
}

// Phase 4: Inventory Management Models

model ProductInventory {
  id                String   @id @default(cuid())
  productId         String   @unique
  
  // Stock levels
  currentStock      Int      @default(0)
  reservedStock     Int      @default(0) // Stock reserved during checkout
  availableStock    Int      @default(0) // currentStock - reservedStock
  
  // Thresholds
  lowStockThreshold Int      @default(5)
  minStockLevel     Int      @default(0)
  maxStockLevel     Int?     // Optional max capacity
  
  // Status tracking
  stockStatus       String   @default("in_stock") // 'in_stock', 'low_stock', 'out_of_stock', 'discontinued'
  isTrackingEnabled Boolean  @default(true)
  allowBackorders   Boolean  @default(false)
  
  // Timestamps
  lastRestocked     DateTime?
  lastSold          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  movements         StockMovement[]
  reservations      StockReservation[]
}

model StockMovement {
  id                String   @id @default(cuid())
  productId         String
  inventoryId       String
  
  // Movement details
  type              String   // 'restock', 'sale', 'adjustment', 'return', 'damaged', 'transfer'
  quantity          Int      // Positive for additions, negative for reductions
  previousStock     Int      // Stock level before movement
  newStock          Int      // Stock level after movement
  
  // Reference data
  orderId           String?  // If related to an order
  userId            String?  // User who made the change
  reason            String?  // Reason for manual adjustments
  notes             String?  // Additional notes
  
  // Batch/lot tracking
  batchNumber       String?
  expirationDate    DateTime?
  supplier          String?
  cost              Float?   // Cost per unit for restocking
  
  inventory         ProductInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
}

model StockReservation {
  id                String   @id @default(cuid())
  productId         String
  inventoryId       String
  
  // Reservation details
  quantity          Int
  status            String   @default("active") // 'active', 'fulfilled', 'expired', 'cancelled'
  
  // Reference data
  orderId           String?  // Order this reservation is for
  cartSessionId     String?  // Cart session for guest users
  userId            String?  // User who made the reservation
  
  // Timing
  expiresAt         DateTime // When reservation expires
  fulfilledAt       DateTime?
  
  inventory         ProductInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([expiresAt])
  @@index([status])
}

model StockAlert {
  id                String   @id @default(cuid())
  productId         String
  
  // Alert details
  type              String   // 'low_stock', 'out_of_stock', 'reorder_point', 'overstock'
  severity          String   @default("medium") // 'low', 'medium', 'high', 'critical'
  message           String
  currentStock      Int
  thresholdValue    Int?
  
  // Status
  isActive          Boolean  @default(true)
  isAcknowledged    Boolean  @default(false)
  acknowledgedBy    String?  // User ID who acknowledged
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([isActive, productId])
  @@index([type, severity])
}

// Analytics and Marketing Models
model CustomerProfile {
  id               String   @id @default(cuid())
  email            String?  @unique
  segments         String   // JSON array of segment names
  behaviorScore    Int      @default(0) @map("behavior_score")
  preferences      String   // JSON object for user preferences
  lifetimeValue    Float    @default(0) @map("lifetime_value")
  engagementScore  Int      @default(0) @map("engagement_score")
  lastActivity     DateTime @default(now()) @map("last_activity")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  events           AnalyticsEvent[]
  emailCampaigns   EmailCampaign[]

  @@map("customer_profiles")
}

model AnalyticsEvent {
  id            String   @id @default(cuid())
  eventName     String   @map("event_name")
  userId        String?  @map("user_id")
  sessionId     String?  @map("session_id")
  properties    String   // JSON object for event properties
  timestamp     DateTime @default(now())
  pageUrl       String?  @map("page_url")

  // Relations
  customer      CustomerProfile? @relation(fields: [userId], references: [id])

  @@index([eventName])
  @@index([userId])
  @@index([sessionId])
  @@index([timestamp])
  @@map("analytics_events")
}

model EmailCampaign {
  id          String   @id @default(cuid())
  name        String
  type        String   // 'sequence', 'broadcast', 'automated'
  templateId  String   @map("template_id")
  segments    String   // JSON array of target segments
  content     Json?
  metrics     String   // JSON object for campaign metrics
  status      String   @default("draft")
  scheduledAt DateTime? @map("scheduled_at")
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  // Relations
  promoCodes  PromoCode[]
  customers   CustomerProfile[]
  deliveries  EmailCampaignDelivery[]

  @@index([status, scheduledAt])
  @@map("email_campaigns")
}

/// One row per recipient per campaign so sends can resume and retries never double-deliver.
model EmailCampaignDelivery {
  id          String   @id @default(cuid())
  campaignId  String   @map("campaign_id")
  email       String
  status      String   // 'sent' | 'failed'
  error       String?
  attemptedAt DateTime @default(now()) @map("attempted_at")

  campaign    EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@map("email_campaign_deliveries")
}

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  campaignId    String?   @map("campaign_id")
  discountType  String    @map("discount_type") // 'percentage' or 'fixed'
  discountValue Float     @map("discount_value")
  usageLimit    Int?      @map("usage_limit")
  usageCount    Int       @default(0) @map("usage_count")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  campaign      EmailCampaign? @relation(fields: [campaignId], references: [id])

  @@map("promo_codes")
}

// Marketing Channel Models
model SocialMediaPost {
  id            String   @id @default(cuid())
  platform      String   // 'facebook', 'instagram', 'twitter', 'linkedin', 'tiktok'
  postId        String?  // Platform-specific post ID
  content       String   // Post content/caption
  mediaUrls     String   // JSON array of image/video URLs
  
  // Scheduling
  scheduledAt   DateTime?
  publishedAt   DateTime?
  status        String   @default("draft") // 'draft', 'scheduled', 'published', 'failed'
  
  // Engagement metrics
  engagement    String   // JSON object with likes, comments, shares, reach, clicks
  
  // Campaign tracking
  campaignId    String?
  hashtags      String?  // JSON array of hashtags used
  mentions      String?  // JSON array of mentions
  
  // Meta data
  createdBy     String?  // User ID who created the post
  notes         String?  // Internal notes
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([platform, publishedAt])
  @@index([status])
  @@map("social_media_posts")
}

model AdCampaign {
  id            String   @id @default(cuid())
  name          String
  platform      String   // 'google', 'facebook', 'instagram', 'linkedin', 'twitter'
  campaignId    String?  // Platform-specific campaign ID
  
  // Campaign details
  type          String   // 'search', 'display', 'video', 'shopping', 'social'
  objective     String   // 'awareness', 'traffic', 'conversions', 'sales'
  targetAudience String  // JSON object with targeting criteria
  
  // Budget and bidding
  budgetType    String   // 'daily', 'lifetime'
  budgetAmount  Float
  bidStrategy   String   // 'cpc', 'cpm', 'cpa', 'roas'
  bidAmount     Float?
  
  // Creative assets
  adSets        String   // JSON array of ad set configurations
  creatives     String   // JSON array of ad creatives (images, videos, copy)
  
  // Scheduling
  startDate     DateTime
  endDate       DateTime?
  
  // Performance metrics
  performance   String   // JSON object with impressions, clicks, conversions, cost, roas
  
  // Status and tracking
  status        String   @default("draft") // 'draft', 'active', 'paused', 'completed', 'cancelled'
  
  // Meta data
  createdBy     String?  // User ID who created the campaign
  notes         String?  // Campaign notes
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([platform, status])
  @@index([startDate, endDate])
  @@map("ad_campaigns")
}

// Marketing Attribution Model
model MarketingAttribution {
  id            String   @id @default(cuid())
  orderId       String   // Reference to order
  userId        String?  // User who made the purchase
  
  // Attribution data
  firstTouch    String   // JSON object with first touch point data
  lastTouch     String   // JSON object with last touch point data
  touchpoints   String   // JSON array of all touchpoints in customer journey
  
  // Channel attribution
  primaryChannel String  // Primary attributed channel
  attribution   String   // JSON object with attribution weights per channel
  
  // Revenue attribution
  attributedRevenue Float
  
  createdAt     DateTime @default(now())
  
  @@index([orderId])
  @@index([primaryChannel])
  @@map("marketing_attribution")
}

// Marketing Budget Tracking
model MarketingBudget {
  id            String   @id @default(cuid())
  channel       String   // 'email', 'social', 'ads', 'content', 'seo'
  period        String   // 'monthly', 'quarterly', 'yearly'
  periodStart   DateTime
  periodEnd     DateTime
  
  // Budget allocation
  allocatedBudget Float
  spentBudget    Float   @default(0)
  remainingBudget Float  @default(0)
  
  // Performance tracking
  targetRevenue  Float?
  actualRevenue  Float   @default(0)
  targetRoi      Float?
  actualRoi      Float   @default(0)
  
  // Status
  status         String  @default("active") // 'active', 'exhausted', 'completed'
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([channel, periodStart])
  @@map("marketing_budgets")
}

// In-Person Markets & Pop-Ups
model MarketEvent {
  id                String    @id @default(cuid())
  slug              String    @unique
  name              String
  location          String?
  startDate         DateTime  @map("start_date")
  endDate           DateTime? @map("end_date")
  boothFee          Float     @default(0) @map("booth_fee")
  otherExpenses     Float     @default(0) @map("other_expenses")
  salesTaxRate      Float     @default(0) @map("sales_tax_rate")
  promoCode         String?   @map("promo_code")
  followUpEnabled   Boolean   @default(false) @map("follow_up_enabled")
  followUpDelayDays Int       @default(1) @map("follow_up_delay_days")
  followUpSubject   String?   @map("follow_up_subject")
  followUpBody      String?   @map("follow_up_body")
  followUpSentAt    DateTime? @map("follow_up_sent_at")
  priceSheetConfig  Json?     @map("price_sheet_config")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  orders            Order[]

  @@index([startDate])
  @@map("market_events")
}

// Studio Jobs Spine (Proposals, Milestones, Deposit/Balance Payments, Proofs)
model StudioJob {
  id             String    @id @default(cuid())
  jobNumber      String    @unique @map("job_number")
  shareToken     String    @unique @map("share_token")
  title          String
  category       String    @default("custom")
  status         String    @default("inquiry")
  clientName     String    @map("client_name")
  clientEmail    String    @map("client_email")
  threadId       String?   @map("thread_id")
  scope          String    @default("")
  medium         String?
  dimensions     String?
  totalCents     Int       @default(0) @map("total_cents")
  depositPercent Int       @default(50) @map("deposit_percent")
  depositCents   Int       @default(0) @map("deposit_cents")
  balanceCents   Int       @default(0) @map("balance_cents")
  currency       String    @default("USD")
  turnaroundDays Int       @default(21) @map("turnaround_days")
  dueDate        DateTime? @map("due_date")
  licenseType    String    @default("personal") @map("license_type")
  revisionCap    Int       @default(2) @map("revision_cap")
  killFeePercent Int       @default(25) @map("kill_fee_percent")
  termsSnapshot  Json?     @map("terms_snapshot")
  acceptedAt     DateTime? @map("accepted_at")
  depositOrderId String?   @unique @map("deposit_order_id")
  balanceOrderId String?   @unique @map("balance_order_id")
  depositPaidAt  DateTime? @map("deposit_paid_at")
  balancePaidAt  DateTime? @map("balance_paid_at")
  notes          String?
  timeline       Json      @default("[]")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([clientEmail])
  @@index([threadId])
  @@map("studio_jobs")
}

// Certificates of Authenticity (Auto-issued on certified paid orders & jobs; public /verify/[code])
model CertificateOfAuthenticity {
  id             String    @id @default(cuid())
  code           String    @unique
  orderId        String?   @map("order_id")
  jobId          String?   @map("job_id")
  productId      String?   @map("product_id")
  artworkTitle   String    @map("artwork_title")
  artistName     String    @map("artist_name")
  medium         String?
  dimensions     String?
  year           Int?
  editionInfo    String?   @map("edition_info")
  licenseType    String    @default("personal") @map("license_type")
  collectorName  String?   @map("collector_name")
  collectorEmail String?   @map("collector_email")
  artworkImage   String?   @map("artwork_image")
  issuedAt       DateTime  @default(now()) @map("issued_at")
  revokedAt      DateTime? @map("revoked_at")

  @@unique([orderId, productId])
  @@index([orderId])
  @@index([jobId])
  @@map("certificates_of_authenticity")
}

// Gallery & Venue Consignment Log
model ConsignmentPlacement {
  id                 String    @id @default(cuid())
  productId          String    @map("product_id")
  venueName          String    @map("venue_name")
  contactName        String?   @map("contact_name")
  contactEmail       String?   @map("contact_email")
  quantity           Int       @default(1)
  askingPrice        Float     @map("asking_price")
  artistSplitPercent Int       @default(60) @map("artist_split_percent")
  status             String    @default("out")
  placedAt           DateTime  @default(now()) @map("placed_at")
  returnDueAt        DateTime? @map("return_due_at")
  closedAt           DateTime? @map("closed_at")
  reminderSentAt     DateTime? @map("reminder_sent_at")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([productId])
  @@index([status, returnDueAt])
  @@map("consignment_placements")
}