{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "rules": {
    "@typescript-eslint/no-unused-vars": "warn",
    "@typescript-eslint/no-explicit-any": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "no-console": "warn"
  },
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    "out/**",
    "build/**",
    "coverage/**",
    "*.config.js",
    "*.config.mjs",
    "*.config.ts",
    "dist/**"
  ],
  "overrides": [
    {
      "files": [
        "synthetics/**/*.js"
      ],
      "rules": {
        "no-console": "off",
        "import/no-unresolved": "off",
        "import/no-default-export": "off"
      }
    }
  ]
}