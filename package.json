{
  "name": "artistsite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --watchAll=false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:full": "npm run test:ci && npm run test:e2e",
    "test:load": "node -e \"require('./src/lib/testing/test-automation.js').TestAutomation.runLoadTestSuite()\"",
    "debug": "DEBUG_MODE=true next dev",
    "debug:build": "DEBUG_MODE=true next build",
    "debug:inspect": "NODE_OPTIONS='--inspect' next dev",
    "test:preview": "./src/scripts/test-preview.sh",
    "analyze": "ANALYZE=true npm run build",
    "type-check": "tsc --noEmit",
    "docker:build": "docker build -t artistsite .",
    "docker:run": "docker run -p 3000:3000 artistsite",
    "docker:dev": "docker-compose up --build",
    "docker:staging": "docker-compose -f docker-compose.staging.yml up --build",
    "deploy:staging": "./scripts/deploy-staging.sh",
    "deploy:production": "./scripts/deploy-production.sh",
    "health:check": "curl -f http://localhost:3000/api/health",
    "lighthouse:ci": "lhci autorun",
    "security:audit": "npm audit --audit-level moderate",
    "security:scan": "node -e \"require('./src/lib/security/security-auditor.ts').SecurityAuditor.runCompleteSecurityAudit().then(console.log)\"",
    "production:readiness": "node -e \"require('./src/lib/security/security-auditor.ts').ProductionReadinessAuditor.runProductionReadinessCheck().then(console.log)\"",
    "performance:benchmark": "node scripts/performance-benchmark.js",
    "performance:benchmark:staging": "BENCHMARK_URL=https://staging.artistsite.com npm run performance:benchmark",
    "performance:benchmark:prod": "BENCHMARK_URL=https://artistsite.com npm run performance:benchmark",
    "performance:monitor": "node -e \"require('./src/lib/performance/performance-monitor.ts').PerformanceMonitor.getOptimizationRecommendations().then(console.log)\"",
    "ci:pipeline": "npm run lint && npm run type-check && npm run test:ci && npm run build",
    "ci:full": "npm run lint && npm run type-check && npm run test:full && npm run security:scan && npm run build",
    "monitoring:dashboard": "echo 'Visit http://localhost:3000/debug/monitoring for monitoring dashboard'",
    "precommit": "npm run lint && npm run type-check && npm run test:ci",
    "playwright:install": "playwright install",
    "syn:smoke": "export SYNTHETIC_BASE_URL=https://michalelena.me && k6 run synthetics/k6/uptime/homepage.k6.js && k6 run synthetics/k6/api/health.k6.js",
    "syn:health": "k6 run synthetics/k6/api/health.k6.js",
    "syn:readiness": "k6 run synthetics/k6/api/readiness.k6.js",
    "syn:search": "k6 run synthetics/k6/api/search.k6.js",
    "syn:uptime": "for f in synthetics/k6/uptime/*.k6.js; do k6 run $f; done",
    "syn:all": "npm run syn:uptime && npm run syn:health && npm run syn:readiness && npm run syn:search",
    "syn:grafana:provision": "node synthetics/grafana/create-checks.js",
    "syn:grafana:test": "node synthetics/grafana/test-api.js"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.1.1",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.3.5",
    "@prisma/client": "^6.12.0",
    "@stripe/stripe-js": "^7.5.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tiptap/extension-character-count": "^3.0.7",
    "@tiptap/extension-image": "^3.0.7",
    "@tiptap/extension-link": "^3.0.7",
    "@tiptap/extension-placeholder": "^3.0.7",
    "@tiptap/react": "^3.0.7",
    "@tiptap/starter-kit": "^3.0.7",
    "@types/bcryptjs": "^3.0.0",
    "@vercel/og": "^0.7.2",
    "@vercel/otel": "^1.12.1",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "critters": "^0.0.25",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.525.0",
    "mdx-bundler": "^10.1.1",
    "next": "15.3.5",
    "next-auth": "^4.24.11",
    "next-sitemap": "^4.2.3",
    "prisma": "^6.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.60.0",
    "schema-dts": "^1.1.5",
    "stripe": "^18.3.0",
    "swr": "^2.3.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17",
    "web-vitals": "^5.0.3",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.3.5",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "playwright": "^1.54.1",
    "postcss": "^8",
    "typescript": "^5"
  }
}
